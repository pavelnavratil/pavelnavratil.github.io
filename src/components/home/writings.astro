---
import PostsLoop from "@components/blog/slice-loop.astro";
import Button from "@components/common/button.astro";
import {
	getLangFromUrl,
	useTranslatedPath,
	useTranslations,
} from "@i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section class="max-w-4xl mx-auto px-7 lg:px-0">
  <h2
    class="text-2xl font-bold leading-10 tracking-tight text-heading"
  >
    {t('writings.title')}
  </h2>
  <p class="mb-6 text-base text-muted-foreground">
    {t('writings.desc')}
  </p>

  <div class="grid items-stretch w-full sm:grid-cols-2 gap-7 mt-7">
    <PostsLoop count={2} />
  </div>
  <div class="flex items-center justify-center w-full py-5">
    <Button text={t('nav.thoughts')} link={translatePath('/posts/')} />
  </div>
</section>
