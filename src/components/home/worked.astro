---
import {
	getLangFromUrl,
	useTranslatedPath,
	useTranslations,
} from "@i18n/utils";
import type { WorkEntry } from "../../types/content";
const lang = getLangFromUrl(Astro.url);
interface Props {
	worked: WorkEntry[];
}
const { worked } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
import Button from "@components/common/button.astro";
import Work from "@components/item-template/work.astro";
---

<section class="max-w-4xl mx-auto px-7 lg:px-0">
  <h2
    class="text-2xl font-bold leading-10 tracking-tight text-heading"
  >
    {t('worked.title')}
  </h2>
  <p class="mb-6 text-base text-muted-foreground">
    {t('worked.desc')}
  </p>
  <div
    class="grid items-stretch w-full sm:grid-cols-2 gap-7 mt-7"
  >
    {
      worked.map((work) => {
        return (
          <Work
            name={work.name}
            description={work.description}
            image={work.image}
          />
        )
      })
    }
  </div>

  <div class="flex items-center justify-center w-full py-5">
    <Button text={t('nav.allWork')} link={translatePath('/worked/')} />
  </div>
</section>
