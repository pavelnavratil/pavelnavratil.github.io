---
import { getCollection } from "astro:content";
import Item from "@components/blog/item.astro";
import { getLangFromUrl } from "@i18n/utils";
const pageLang = getLangFromUrl(Astro.url);
interface Props {
	count: number;
}
const { count } = Astro.props;
const allPosts = await getCollection("blog", ({ id }) =>
	id.startsWith(`${pageLang}/`),
);
const orderedPosts = allPosts.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const posts = orderedPosts.slice(0, count);
---
{posts.map((post) => <Item post={post} showArrow={false} />)}
