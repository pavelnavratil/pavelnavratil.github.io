---
import { languages } from "@i18n/ui";
import {
	getLangFromUrl,
	getPathWithoutLanguage,
	useTranslatedPath,
} from "@i18n/utils";

const pageLang = getLangFromUrl(Astro.url);
const pagePath = getPathWithoutLanguage(Astro.url);
const translatePath = useTranslatedPath(pageLang);
const alternateLanguages = (
	Object.keys(languages) as (keyof typeof languages)[]
).filter((locale) => locale !== pageLang);
---

{alternateLanguages.map((locale) => (
  <a href={translatePath(pagePath, locale)} lang={locale} hreflang={locale} aria-label={`Switch to ${languages[locale]}`} class="text-xs px-3 py-1.5 rounded-sm border transition-colors duration-200 bg-muted border-border text-muted-foreground hover:text-primary hover:border-primary font-mono">
    $ lang --{locale}
  </a>
))}
