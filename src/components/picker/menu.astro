---
import menus from "@collections/menu.json";
import { ui } from "@i18n/ui";
import {
	getLangFromUrl,
	useTranslatedPath,
	useTranslations,
} from "@i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const { mobile = false } = Astro.props;
const currentPath = Astro.url.pathname.endsWith("/")
	? Astro.url.pathname
	: `${Astro.url.pathname}/`;
---
{
  menus.map((menu) => {
    const link = menu.url;
    const translationKey = `nav.${menu.key}` as keyof typeof ui.en;
    const href = translatePath(link);
    // Home matches exactly; every other entry also matches its nested pages.
    // (`href` is '/cs/' for Czech home, so a prefix test would match every page.)
    const isCurrent = link === '/' ? currentPath === href : currentPath.startsWith(href);
    
    return (
    <a
      href={href}
      data-nav-key={menu.key}
      class:list={[
        "text-primary transition-colors hover:underline",
        mobile ? "w-full py-2 text-base text-left" : "text-sm",
        isCurrent ? "underline underline-offset-4" : ""
      ]}
      aria-current={isCurrent ? 'page' : undefined}
    >
      {t(translationKey)}
    </a>
      )
    })
  }
