---
import menus from "@collections/menu.json";
import { getLangFromUrl, useTranslations, useTranslatedPath } from '@i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const { mobile = false } = Astro.props;
---
{
  menus.map((menu) => {
    const link = menu.url;
    const translationKey = `nav.${menu.key}`;
    const href = translatePath(link);
    
    return (
    <a
      href={href}
      class:list={[
        "transition-colors hover:text-primary",
        mobile ? "w-full py-2 text-base text-left" : "text-sm",
        Astro.url.pathname === href || (href !== '/' && Astro.url.pathname.startsWith(`${href}/`)) ? "underline underline-offset-4" : ""
      ]}
    >
      {t(translationKey)}
    </a>
      )
    })
  }
