---
import menus from "@collections/menu.json";
import { ui } from "@i18n/ui";
import {
	getLangFromUrl,
	useTranslatedPath,
	useTranslations,
} from "@i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const { mobile = false } = Astro.props;
---
{
  menus.map((menu) => {
    const link = menu.url;
    const translationKey = `nav.${menu.key}` as keyof typeof ui.en;
    const href = translatePath(link);
    const isCurrent = Astro.url.pathname === href || (href !== '/' && Astro.url.pathname.startsWith(`${href}/`));
    
    return (
    <a
      href={href}
      class:list={[
        "text-primary transition-colors hover:underline",
        mobile ? "w-full py-2 text-base text-left" : "text-sm",
        isCurrent ? "underline underline-offset-4" : ""
      ]}
      aria-current={isCurrent ? 'page' : undefined}
    >
      {t(translationKey)}
    </a>
      )
    })
  }
