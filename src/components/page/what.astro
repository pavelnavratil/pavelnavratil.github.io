---
import type { CertificationEntry, ExperienceEntry } from "../../types/content";
interface Props {
	certifications: CertificationEntry[];
	experiences: ExperienceEntry[];
}
const { certifications, experiences } = Astro.props;
import AboutExperience from "@components/item-template/about-experience.astro";
import Certificate from "@components/item-template/certificate.astro";
import PageHeading from "@components/page-template/page-heading.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import Layout from "@layouts/main.astro";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const certificationCategories = [
	...new Set(certifications.map((certificate) => certificate.category)),
];
---
<Layout language={lang} title={t('what.title')} description={t('what.desc')}>
  <section class="relative z-20 max-w-4xl mx-auto my-12 px-7 lg:px-0">
    <PageHeading
      title={t('what.title')}
      description={t('what.desc')}
    />

    <h2 class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 text-heading">{t('bio.title')}</h2>
    <p
      class="text-sm leading-6 text-muted-foreground sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      {t('bio.desc')}
    </p>

    <h2
      class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 text-heading"
    >
      {t('certifications.title')}
    </h2>
    <div
      class="flex flex-wrap gap-2 mt-6"
      role="group"
      aria-label={t('certifications.filterByCategory')}
      data-certification-filters
    >
      <button class="certification-filter" type="button" data-category-filter="*" aria-pressed="true">
        {t('certifications.all')}
      </button>
      {
        certificationCategories.map((category) => (
          <button class="certification-filter" type="button" data-category-filter={category} aria-pressed="false">
            {category}
          </button>
        ))
      }
    </div>
    <div
      class="z-50 grid items-stretch w-full grid-cols-1 my-8 gap-7 sm:gap-5 sm:grid-cols-2"
      data-certification-grid
    >
      {
        certifications.map((certificate, index) => {
          return (
            <Certificate
              name={certificate.name}
              description={certificate.description}
              image={certificate.credentialBadge}
              url={certificate.credentialUrl}
              issueDate={certificate.issueDate}
              category={certificate.category}
              retiringOn={certificate.retiringOn}
              isAboveFold={index === 0}
            />
          )
        })
      }
    </div>
    
    <h2
      class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 text-heading"
    >
      {t('experience.title')}
    </h2>
    <div class="relative mt-10 ml-3 border-l border-border">
      {
        experiences.map((experience, index) => {
          return (
            <>
                <AboutExperience
                  dates={experience.dates}
                  role={experience.role}
                  company={experience.company}
                  description={experience.description}
                  isLatest={index === 0}
                />
            </>
          )
        })
      }
    </div>
  
    <h2 class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 text-heading">{t('connect.title')}</h2>
    <p
      class="text-sm leading-6 text-muted-foreground sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      {t('connect.prompt')} <a href="mailto:navratil@inp.cz" class="text-primary underline"
        >{t('connect.email')}</a
      >.
    </p>
  </section>
  <style>
    .certification-filter {
      border: 1px solid hsl(var(--accent));
      border-radius: 0.125rem;
      padding: 0.5rem 1.25rem;
      background: transparent;
      color: hsl(var(--accent));
      font-size: 0.75rem;
      font-weight: 600;
      transition: background-color 150ms ease, color 150ms ease;
    }

    .certification-filter:hover,
    .certification-filter[aria-pressed='true'] {
      background: hsl(var(--accent));
      color: hsl(var(--accent-foreground));
    }
  </style>

  <script>
    const filterGroups = document.querySelectorAll('[data-certification-filters]');

    filterGroups.forEach((filterGroup) => {
      const grid = filterGroup.nextElementSibling;
      if (!grid?.matches('[data-certification-grid]')) return;

      const buttons = [...filterGroup.querySelectorAll('[data-category-filter]')];
      const cards = [...grid.querySelectorAll('[data-certification-card]')];

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const category = button.getAttribute('data-category-filter');

          buttons.forEach((candidate) => {
            candidate.setAttribute('aria-pressed', String(candidate === button));
          });

          cards.forEach((card) => {
            const matches = category === '*' || card.getAttribute('data-category') === category;
            card.classList.toggle('hidden', !matches);
          });
        });
      });
    });
  </script>
</Layout>
