---
import PageHeading from "@components/page-template/page-heading.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import Layout from "@layouts/main.astro";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<Layout language={lang} title={t('who.title')} description={t('who.desc')}>
  <section class="relative z-20 max-w-4xl mx-auto my-12 px-7 lg:px-0">
    <PageHeading
      title={t('who.title')}
      description={t('who.desc')}
    />

    <h2 class="mt-5 mb-2 text-2xl font-bold lg:mt-10 sm:mt-6 text-heading">{t('about.title')}</h2>
    <p
      class="text-sm leading-6 text-muted-foreground sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      {t('about.desc')}
    </p>
  </section>
</Layout>
