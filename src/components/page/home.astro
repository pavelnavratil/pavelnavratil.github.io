---
import type { ProjectEntry, WorkEntry } from "../../types/content";
interface Props {
	projectsCol: ProjectEntry[];
	workedCol: WorkEntry[];
}
const { projectsCol, workedCol } = Astro.props;
import Button from "@components/common/button.astro";
import Projects from "@components/home/projects.astro";
import Separator from "@components/home/separator.astro";
import Worked from "@components/home/worked.astro";
import Writings from "@components/home/writings.astro";
import {
	getLangFromUrl,
	useTranslatedPath,
	useTranslations,
} from "@i18n/utils";
import Layout from "@layouts/main.astro";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---
<Layout language={lang} title={t('home.title')} description={`${t('home.am')} ${t('home.dev')}`}>
  <section class="relative z-20 w-full max-w-4xl mx-auto mt-16 px-7 md:mt-24 lg:mt-32 xl:px-0">
    <div class="flex flex-col items-center md:flex-row">
      <div class="relative w-full">
        <h1
          class="mb-5 text-4xl font-bold leading-tight md:text-4xl lg:text-6xl text-heading"
        >
          <span class="text-muted-foreground">[</span><span class="text-primary">✓</span><span class="text-muted-foreground">]</span>{' '}{t('home.hello')}<span class="terminal-cursor" aria-hidden="true"></span>
        </h1>
        <p class="mb-6 text-base text-foreground">
          {t('home.am')}
          <br class="hidden lg:block" />
          {t('home.dev')}
        </p>
        <p class="mb-6 text-base text-foreground">
          {t('home.layered')}
        </p>
        <p class="mb-2 mt-6 font-semibold text-foreground">
          {t('home.help')}
        </p>
        <ul class="py-2 space-y-[3px] text-sm text-foreground">
          <li><span class="mr-1">&gt;</span>{t('home.sfDev')}</li>
          <li><span class="mr-1">&gt;</span>{t('home.sfArch')}</li>
          <li><span class="mr-1">&gt;</span>{t('home.webDev')}</li>
          <li><span class="mr-1">&gt;</span>{t('home.more')}</li>
        </ul>
        <Button text={t('nav.what')} link={translatePath('/what/')} />
      </div>
    </div>
  </section>

  <Separator text={t('projects.separator')} />
  <Projects projects={projectsCol} />
  <Separator text={t('worked.separator')} />
  <Worked worked={workedCol} />
  <Separator text={t('writings.separator')} />
  <Writings />
</Layout>
