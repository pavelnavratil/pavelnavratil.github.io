---
import LanguagePicker from "@components/picker/language.astro";
import StylePicker from "@components/picker/style.astro";
interface Props {
	showLanguagePicker?: boolean;
}
const { showLanguagePicker = true } = Astro.props;
---

<footer class="mt-auto border-t border-border bg-card text-foreground">
  <div class="max-w-4xl mx-auto px-7 lg:px-0 py-8 flex flex-col gap-5 md:flex-row md:justify-end">
		<div class="flex flex-col-reverse items-start gap-4 md:flex-row md:items-center">
			<StylePicker />
			{showLanguagePicker && <LanguagePicker />}
    </div>
  </div>
</footer>
