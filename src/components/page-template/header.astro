---
import Logo from "@components/page-template/logo.astro";
import MenuPicker from "@components/picker/menu.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="relative z-50 border-b border-border bg-background/95 backdrop-blur-sm">
  <div class="max-w-4xl mx-auto px-7 lg:px-0 py-4 md:py-6 lg:py-8 flex items-center justify-between gap-4">
    <Logo />
    <nav aria-label="Primary navigation" class="flex items-center gap-3">
      <div class="hidden lg:flex items-center gap-4"><MenuPicker /></div>
      <button
        id="menuToggle"
        type="button"
        aria-controls="mobileMenu"
        aria-expanded="false"
        aria-label={t('menu.open')}
        data-label-open={t('menu.open')}
        data-label-close={t('menu.close')}
        class="inline-flex h-9 w-9 items-center justify-center rounded border border-border bg-card/50 lg:hidden"
      >
        <svg id="menuOpenIcon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg id="menuCloseIcon" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
    </nav>
  </div>
  <button id="mobileMenuBackdrop" class="fixed inset-0 z-40 hidden bg-background/85 backdrop-blur-sm lg:hidden" aria-hidden="true" tabindex="-1"></button>
  <div id="mobileMenu" class="fixed left-4 right-4 top-20 z-50 hidden rounded border border-border bg-card p-4 shadow-lg lg:hidden">
    <nav aria-label="Mobile navigation" class="flex flex-col items-start gap-2"><MenuPicker mobile /></nav>
  </div>
</header>
