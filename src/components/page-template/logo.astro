---
import { getLangFromUrl, useTranslatedPath } from '@i18n/utils';
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
---
<a
  href={translatePath('/')}
  class="relative z-30 inline-flex text-primary transition-colors hover:text-heading"
  aria-label="Home"
>
  <svg aria-hidden="true" fill="none" height="36" viewBox="0 0 100 100" width="36">
    <path d="M38,16 L20,50 L38,84" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="4" />
    <path d="M62,16 L80,50 L62,84" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="4" />
    <path d="M38,16 L62,84" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="4" />
  </svg>
</a>
