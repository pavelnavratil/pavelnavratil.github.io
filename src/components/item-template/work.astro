---
const { name, description, image, isAboveFold = false } = Astro.props;
import { Image } from 'astro:assets';
---

<div class="relative flex flex-col items-stretch duration-300 ease-out p-7 sm:p-3 group h-100 rounded-lg"
>
  <span
    class="absolute inset-0 z-20 block w-full h-full duration-300 ease-out bg-transparent border border-transparent border-dashed group-hover:-translate-x-1 group-hover:-translate-y-1 group-hover:border-primary/50 rounded-lg group-hover:bg-card"
  ></span>
  <span
    class="absolute inset-0 z-10 block w-full h-full duration-300 ease-out border border-dashed rounded-lg border-border group-hover:translate-x-1 group-hover:translate-y-1"
  ></span>
  <span
    class="relative z-30 block duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1"
  >
    <span class="block w-full">
      <Image
        src={image}
        alt={name}
        class="w-full h-auto rounded-sm aspect-[1350/768]"
        loading={isAboveFold ? 'eager' : 'lazy'}
        fetchpriority={isAboveFold ? 'high' : 'auto'}
        width={1350}
        height={768}
      />
    </span>
    <span class="block w-full px-1 mt-5 mb-1 sm:mt-3">
      <span
        class="flex items-center mb-0 text-base font-semibold tracking-tight text-foreground"
      >
        <span>{name}</span>
      </span>
      <span class="text-sm text-muted-foreground"
        >{description}</span
      >
    </span>
  </span>
</div>
