---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { formatRetiringOn, isRetired } from "@utils/certifications";
import { getImage } from "@utils/images";
import type { CertificationEntry } from "../../types/content";
interface Props {
	name: CertificationEntry["name"];
	description: CertificationEntry["description"];
	url: CertificationEntry["credentialUrl"];
	image: CertificationEntry["credentialBadge"];
	category: CertificationEntry["category"];
	issueDate: CertificationEntry["issueDate"];
	retiringOn?: CertificationEntry["retiringOn"];
	isAboveFold?: boolean;
}
const {
	name,
	description,
	url,
	image,
	category,
	issueDate,
	retiringOn,
	isAboveFold = false,
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const imageMetadata = getImage(image);
const isActive = !isRetired(retiringOn);
const retiringOnLabel = retiringOn ? formatRetiringOn(retiringOn, lang) : "";
---

<a href={url} target="_blank" rel="noopener noreferrer" data-certification-card data-category={category} class="relative flex flex-col items-stretch duration-300 ease-out p-7 sm:p-3 group rounded-lg">
  <span class="absolute inset-0 z-20 block w-full h-full duration-300 ease-out bg-transparent border border-transparent border-dashed group-hover:-translate-x-1 group-hover:-translate-y-1 group-hover:border-primary/50 rounded-lg group-hover:bg-card"></span>
  <span class="absolute inset-0 z-10 block w-full h-full duration-300 ease-out border border-dashed rounded-lg border-border group-hover:translate-x-1 group-hover:translate-y-1"></span>
  <span class="relative z-30 flex flex-row gap-4 duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1">
    <span class="flex-shrink-0 mt-1">
      <Image
        src={imageMetadata}
        alt=""
        class="w-14 h-14 sm:w-16 sm:h-16 object-contain rounded-md"
        decoding="async"
        loading={isAboveFold ? 'eager' : 'lazy'}
        fetchpriority={isAboveFold ? 'high' : 'auto'}
        widths={[56, 64, 112, 128]}
        sizes="(min-width: 640px) 64px, 56px"
        format="webp"
      />
    </span>
    <span class="flex flex-col flex-1 min-w-0">
      <span class="inline-block mb-1 text-xs uppercase tracking-widest font-semibold text-accent">{category}</span>
      <span class="flex items-center mb-0.5 text-base font-semibold tracking-tight text-foreground">
        <span>{name}</span><span aria-hidden="true" class="ml-1 transition-transform group-hover:translate-x-0.5">↗</span>
      </span>
      <span class="text-xs uppercase tracking-widest text-muted-foreground mb-1">
        {issueDate}{retiringOnLabel && ` · ${t(isActive ? 'certifications.retiresOn' : 'certifications.retiredOn')} ${retiringOnLabel}`}
      </span>
      <span
        class:list={[
          "mb-2 inline-flex w-fit items-center rounded-full border px-2 py-0.5 text-[0.625rem] font-semibold uppercase tracking-widest",
          isActive
            ? "border-primary/30 bg-primary/15 text-primary"
            : "border-border bg-muted text-muted-foreground",
        ]}
      >
        {t(isActive ? 'certifications.active' : 'certifications.retired')}
      </span>
      <span class="text-sm font-light text-muted-foreground leading-relaxed">{description}</span>
    </span>
  </span>
</a>
