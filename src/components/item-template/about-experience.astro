---
import type { ExperienceEntry } from "../../types/content";
interface Props extends ExperienceEntry {
	isLatest?: boolean;
}
const { dates, role, company, description, isLatest = false } = Astro.props;
---

<div class="relative pl-8 pb-10 last:pb-0">
  <div class:list={[
    'absolute -left-[5px] top-[5px] w-[10px] h-[10px] rounded-full border-2 bg-background transition-all',
    isLatest
      ? 'border-accent shadow-[0_0_0_3px_rgba(138,90,0,0.15),0_0_10px_rgba(138,90,0,0.35)]'
      : 'border-muted-foreground/40',
  ]}></div>
  <p class="text-xs uppercase text-muted-foreground tracking-widest mb-1">{dates}</p>
  <h3 class:list={['text-base font-bold leading-snug', isLatest ? 'text-accent' : 'text-foreground']}>{role}</h3>
  <p class="text-sm font-medium text-foreground/70 mt-1 mb-2">{company}</p>
  <p class="text-sm font-light text-muted-foreground leading-relaxed">{description}</p>
</div>
