---
import Layout from "@layouts/main.astro";
---

<Layout
  language="en"
  title="Page not found"
  description="The page you requested could not be found."
  noindex
>
  <section class="relative z-20 max-w-4xl mx-auto my-16 px-7 lg:px-0">
    <p class="mb-3 text-sm font-semibold text-accent">404</p>
    <h1 class="text-3xl font-bold tracking-tight text-heading sm:text-4xl">Page not found</h1>
    <p class="mt-4 text-base text-muted-foreground">The address may be incorrect, or the page may have moved.</p>
    <a href="/" class="inline-flex px-5 py-2 mt-6 text-sm font-semibold border rounded-sm bg-primary text-primary-foreground border-primary hover:bg-transparent hover:text-primary">
      Return home
    </a>
  </section>
</Layout>
