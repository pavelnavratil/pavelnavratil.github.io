---
import Footer from "@components/page-template/footer.astro";
import Header from "@components/page-template/header.astro";
import "@assets/css/main.css";
const {language, title} = Astro.props;
---
<html lang={language} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('theme')
      const theme = savedTheme === 'light' || savedTheme === 'dark'
        ? savedTheme
        : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
      document.documentElement.dataset.theme = theme
      document.documentElement.classList.toggle('dark', theme === 'dark')
    </script>

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <Fragment set:html={import.meta.env.HEADER_INJECT} />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground">
    <Header language={language}/>
    <main><slot /></main>
    <Footer language={language} />
    <script src="/src/assets/js/main.js"></script>
    <Fragment set:html={import.meta.env.FOOTER_INJECT} />
  </body>
</html>
