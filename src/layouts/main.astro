---
import Footer from "@components/page-template/footer.astro";
import Header from "@components/page-template/header.astro";
import "@assets/css/main.css";
import { languages } from "@i18n/ui";
import { getPathWithoutLanguage, useTranslatedPath } from "@i18n/utils";
import { authorName } from "@utils/const";

interface Props {
	language: keyof typeof languages;
	title: string;
	description: string;
	type?: "website" | "article";
	publishedTime?: string;
	noindex?: boolean;
}

const {
	language,
	title,
	description,
	type = "website",
	publishedTime,
	noindex = false,
} = Astro.props;
const cleanTitle = title.trim();
const pageTitle =
	cleanTitle === authorName ? cleanTitle : `${cleanTitle} | ${authorName}`;
const canonicalUrl = new URL(
	Astro.url.pathname,
	Astro.site ?? Astro.url.origin,
);
const pagePath = getPathWithoutLanguage(Astro.url);
const translatePath = useTranslatedPath(language);
const alternates = noindex
	? []
	: Object.keys(languages).map((locale) => {
			const localizedPath = translatePath(
				pagePath,
				locale as keyof typeof languages,
			);
			const normalizedPath =
				localizedPath === "/" || localizedPath.endsWith("/")
					? localizedPath
					: `${localizedPath}/`;
			return {
				locale: locale as keyof typeof languages,
				url: new URL(normalizedPath, Astro.site ?? Astro.url.origin),
			};
		});
const defaultAlternate = alternates.find(({ locale }) => locale === "en");
const structuredData =
	type === "article"
		? {
				"@context": "https://schema.org",
				"@type": "BlogPosting",
				headline: cleanTitle,
				description,
				datePublished: publishedTime,
				inLanguage: language,
				url: canonicalUrl,
				author: {
					"@type": "Person",
					name: authorName,
					url: new URL("/", Astro.site ?? Astro.url.origin),
				},
			}
		: {
				"@context": "https://schema.org",
				"@type": "WebPage",
				name: cleanTitle,
				description,
				inLanguage: language,
				url: canonicalUrl,
				isPartOf: {
					"@type": "WebSite",
					name: authorName,
					url: new URL("/", Astro.site ?? Astro.url.origin),
				},
			};
---
<html lang={language} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map(({ locale, url }) => <link rel="alternate" hreflang={locale} href={url} />)}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.url} />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={authorName} />
    <meta property="og:locale" content={language === 'cs' ? 'cs_CZ' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      let savedTheme = null
      try { savedTheme = localStorage.getItem('theme') } catch {}
      const theme = savedTheme === 'light' || savedTheme === 'dark'
        ? savedTheme
        : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
      document.documentElement.dataset.theme = theme
      document.documentElement.classList.toggle('dark', theme === 'dark')
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <Fragment set:html={import.meta.env.HEADER_INJECT} />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground">
    <Header />
    <main><slot /></main>
		<Footer showLanguagePicker={!noindex} />
    <script src="/src/assets/js/main.js"></script>
    <Fragment set:html={import.meta.env.FOOTER_INJECT} />
  </body>
</html>
